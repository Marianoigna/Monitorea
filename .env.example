# ─────────────────────────────────────────────────────────────
# .env.example — Heladería Perlatto
# Copiá este archivo como ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" real al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
API_BASE_URL=http://127.0.0.1:8000

# ── Twilio — WhatsApp Alerts ──────────────────────────────────
# Encontrás estos valores en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número Twilio de origen (Sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Tu número de WhatsApp destino (con código de país)
TWILIO_WHATSAPP_TO=whatsapp:+549XXXXXXXXXX

# ── Umbrales de alertas ───────────────────────────────────────
TEMP_MAX=8.0          # °C — temperatura máxima permitida en heladera
TEMP_MIN=-25.0        # °C — temperatura mínima permitida en freezer
VOLT_MAX=240.0        # V  — voltaje máximo de red
VOLT_MIN=190.0        # V  — voltaje mínimo de red

# Cooldown entre alertas del mismo sensor (segundos). Default: 5 minutos
ALERT_COOLDOWN_SEGUNDOS=300
